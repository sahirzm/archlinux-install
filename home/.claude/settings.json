{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "python3 /home/sahir/.claude/sahir-statusline.py",
    "padding": 0
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "sahir-standards@sahir-kit": true,
    "sahir-review@sahir-kit": true,
    "sahir-concise-style@sahir-kit": true,
    "refine@sahir-kit": true,
    "sahir-statusline@sahir-kit": true,
    "manage-ai-team@manage-ai-team": true
  },
  "extraKnownMarketplaces": {
    "sahir-kit": {
      "source": {
        "source": "directory",
        "path": "/myspace/workspace/claude-code-kit"
      }
    },
    "manage-ai-team": {
      "source": {
        "source": "directory",
        "path": "/home/sahir/.config/manage-ai-team/claude"
      }
    }
  },
  "effortLevel": "low",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim"
}
