{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  },
  "model": "sonnet",
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "python3 /home/sahir/.claude/sahir-statusline.py",
    "padding": 0
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "sahir-standards@sahir-kit": true,
    "sahir-review@sahir-kit": true,
    "sahir-concise-style@sahir-kit": true,
    "refine@sahir-kit": true,
    "sahir-statusline@sahir-kit": true,
    "manage-ai-team@manage-ai-team": true,
    "ai-board@ai-board": true,
    "sahir-visual@sahir-kit": true
  },
  "extraKnownMarketplaces": {
    "sahir-kit": {
      "source": {
        "source": "directory",
        "path": "/myspace/workspace/claude-code-kit"
      },
      "autoUpdate": true
    },
    "manage-ai-team": {
      "source": {
        "source": "directory",
        "path": "/home/sahir/.config/manage-ai-team/claude"
      },
      "autoUpdate": true
    },
    "ai-board": {
      "source": {
        "source": "directory",
        "path": "/myspace/workspace/ai-board"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "low",
  "skipWorkflowUsageWarning": true,
  "theme": "custom:catppuccin-mocha",
  "editorMode": "vim",
  "includeCoAuthoredBy": true,
  "outputStyle": "Concise"
}
