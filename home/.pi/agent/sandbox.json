{
  "enabled": true,
  "network": {
    "allowNetwork": true,
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnixSockets": [],
    "allowedDomains": [
      "localhost",
      "127.0.0.1",
      "html.duckduckgo.com",
      "*.npmjs.org",
      "*.pypi.org",
      "*.github.com",
      "*.gitlab.com",
      "raw.githubusercontent.com",
      "mcp.context7.com",
      "*.maven.org",
      "*.gradle.org",
      "jitpack.io"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home"
    ],
    "allowRead": [
      ".",
      "~/.gitconfig",
      "~/.config/",
      "/dev/null",
      "~/.hypa/",
      "~/.gradle/",
      "~/.zsh_history",
      "~/.cache/",
      "~/.local/",
      "~/.npm/",
      "~/.cargo/",
      "~/.pi/"
    ],
    "allowWrite": [
      ".",
      "/dev/null",
      "~/.hypa/",
      "~/.gradle/",
      "/tmp/",
      "~/.pi/",
      "~/.cache/uv/",
      "~/.agent-browser/",
      "~/.local/share/kotlin/",
      "~/.java/.userPrefs/",
      "~/.npm"
    ],
    "denyWrite": [
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      ".pi/sandbox.json",
      "~/.pi/agent/sandbox.json"
    ]
  }
}
