// "sahir" layout (default_layout in config.kdl): zellij's built-in bar
// shapes (ribbon tabs with \u{e0b0} arrows, " Zellij (session)" prefix, key
// hints at the bottom) drawn by zjstatus in catppuccin-mocha, with the tmux
// extras kept: tab numbers, pane-title tab labels, the Ctrl-a highlight and
// cpu/uptime/weather.
//
// First run: zjstatus and the navigator plugin ask for permissions. Click
// the top bar (or the plugin pane) and press `y`; the answer is cached in
// ~/.cache/zellij and asked again only when a plugin version changes.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zjstatus" {
                // catppuccin-mocha, matching the theme's ribbon colours.
                color_red      "#f38ba8"
                color_mauve    "#cba6f7"
                color_peach    "#fab387"
                color_yellow   "#f9e2af"
                color_green    "#a6e3a1"
                color_teal     "#94e2d5"
                color_sapphire "#74c7ec"
                color_text     "#cdd6f4"
                // kitty's background: the bar has no background of its own, and
                // this colour cuts the arrow notch into each ribbon.
                color_base     "#1e1e2e"

                format_left   "{mode}#[fg=$base,bg=$yellow,bold]({session}) #[fg=$yellow,bg=default]\u{e0b0} {tabs}"
                format_right  "{command_cpu}{command_uptime}{command_weather}"
                format_hide_on_overlength "true"
                format_precedence "lrc"

                // " Zellij (session)" is one yellow ribbon. While the Ctrl-a
                // leader is active " Zellij " turns red (catppuccin's tmux
                // prefix highlight); scroll/search show mauve, rename peach.
                // Every mode is 9 cells wide (the other modes end in a 1-cell
                // arrow, normal mode in an extra space) so the bar does not
                // shift when the mode changes.
                mode_normal       "#[fg=$base,bg=$yellow,bold] Zellij  "
                mode_tmux         "#[fg=$base,bg=$red,bold] Zellij #[fg=$red,bg=$yellow]\u{e0b0}"
                mode_scroll       "#[fg=$base,bg=$mauve,bold] SCROLL #[fg=$mauve,bg=$yellow]\u{e0b0}"
                mode_enter_search "#[fg=$base,bg=$mauve,bold] SEARCH #[fg=$mauve,bg=$yellow]\u{e0b0}"
                mode_search       "#[fg=$base,bg=$mauve,bold] SEARCH #[fg=$mauve,bg=$yellow]\u{e0b0}"
                mode_rename_pane  "#[fg=$base,bg=$peach,bold] RENAME #[fg=$peach,bg=$yellow]\u{e0b0}"

                // Ribbon tabs as in zellij's tab bar. Each shows its position
                // (the Ctrl-a <n> key, renumbered when tabs close or move) and
                // its focused pane's title. Shells keep titles short
                // (ZELLIJ_TITLE_MAX in ~/.zshrc) and Ctrl-a , names the pane.
                // Zellij's own "Tab #N" names are not shown because their
                // number never changes.
                tab_normal   "#[fg=$base,bg=$text]\u{e0b0}#[fg=$base,bg=$text,bold] {index} {focused_pane_title}{bell_indicator}{sync_indicator}{fullscreen_indicator}{floating_indicator} #[fg=$text,bg=default]\u{e0b0}"
                tab_active   "#[fg=$base,bg=$green]\u{e0b0}#[fg=$base,bg=$green,bold] {index} {focused_pane_title}{bell_indicator}{sync_indicator}{fullscreen_indicator}{floating_indicator} #[fg=$green,bg=default]\u{e0b0}"
                // tmux monitor-bell / synchronize-panes / zoom window flags.
                tab_bell_indicator       " \u{f009a}"
                tab_sync_indicator       " \u{f04e6}"
                tab_fullscreen_indicator " \u{f004c}"
                tab_floating_indicator   " \u{f0328}"

                // Right-hand ribbons in the same shape.
                // tmux-cpu.
                command_cpu_command    r#"bash -c "vmstat 1 2 | awk 'END {print 100 - $15}'""#
                command_cpu_format     "#[fg=$base,bg=$teal]\u{e0b0}#[fg=$base,bg=$teal,bold] \u{f4bc} {stdout}% #[fg=$teal,bg=default]\u{e0b0}"
                command_cpu_interval   "10"
                command_cpu_rendermode "static"

                // catppuccin uptime module.
                command_uptime_command    r#"awk '{d=int($1/86400); h=int($1%86400/3600); m=int($1%3600/60); if (d) printf "%dd %dh", d, h; else printf "%dh %dm", h, m}' /proc/uptime"#
                command_uptime_format     "#[fg=$base,bg=$sapphire]\u{e0b0}#[fg=$base,bg=$sapphire,bold] \u{f051f} {stdout} #[fg=$sapphire,bg=default]\u{e0b0}"
                command_uptime_interval   "60"
                command_uptime_rendermode "static"

                // tmux-weather (Austin, Fahrenheit). Hidden while offline.
                command_weather_command           r#"curl -fs --max-time 10 'https://wttr.in/Austin?format=%c%t&u'"#
                command_weather_format            "#[fg=$base,bg=$yellow]\u{e0b0}#[fg=$base,bg=$yellow,bold] {stdout} #[fg=$yellow,bg=default]\u{e0b0}"
                command_weather_interval          "1800"
                command_weather_rendermode        "static"
                command_weather_hideonemptystdout "true"
            }
        }
        children
        // Zellij's key-hint bar: lists the Ctrl-a keys while the leader (or
        // scroll mode) is active.
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    // Zellij's default swap layouts (Ctrl-a Space), copied because a custom
    // layout replaces them. Like the built-in layout this one has two bars,
    // so the pane limits are the built-in ones.
    swap_tiled_layout name="vertical" {
        tab max_panes=5 {
            pane split_direction="vertical" {
                pane
                pane { children; }
            }
        }
        tab max_panes=8 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
            }
        }
        tab max_panes=12 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
                pane { pane; pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="horizontal" {
        tab max_panes=4 {
            pane
            pane
        }
        tab max_panes=8 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
        tab max_panes=12 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="stacked" {
        tab min_panes=4 {
            pane stacked=true { children; }
        }
    }

    swap_tiled_layout name="half-stacked" {
        tab min_panes=5 {
            pane split_direction="vertical" {
                pane
                pane stacked=true { children; }
            }
        }
    }

    swap_floating_layout name="staggered" {
        floating_panes
    }

    swap_floating_layout name="enlarged" {
        floating_panes max_panes=10 {
            pane { x "5%"; y 1; width "90%"; height "90%"; }
            pane { x "5%"; y 2; width "90%"; height "90%"; }
            pane { x "5%"; y 3; width "90%"; height "90%"; }
            pane { x "5%"; y 4; width "90%"; height "90%"; }
            pane { x "5%"; y 5; width "90%"; height "90%"; }
            pane { x "5%"; y 6; width "90%"; height "90%"; }
            pane { x "5%"; y 7; width "90%"; height "90%"; }
            pane { x "5%"; y 8; width "90%"; height "90%"; }
            pane { x "5%"; y 9; width "90%"; height "90%"; }
            pane { x 10; y 10; width "90%"; height "90%"; }
        }
    }

    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane {y "50%"; x "50%"; }
        }
        floating_panes max_panes=2 {
            pane { x "1%"; y "25%"; width "45%"; }
            pane { x "50%"; y "25%"; width "45%"; }
        }
        floating_panes max_panes=3 {
            pane { y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; }
            pane { x "50%"; y "1%"; width "45%"; }
        }
        floating_panes max_panes=4 {
            pane { x "1%"; y "55%"; width "45%"; height "45%"; }
            pane { x "50%"; y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; height "45%"; }
            pane { x "50%"; y "1%"; width "45%"; height "45%"; }
        }
    }
}
