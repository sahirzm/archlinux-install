// Zellij (0.45+) config ported from ~/.config/tmux/tmux.conf.
// tmux features with no zellij equivalent are tracked in zellij_pending_items.
// Zellij reloads this file automatically when it changes (no tmux `r` binding).

// Ctrl-a is the only leader, as in tmux. Zellij's other Ctrl-* mode keys
// (Ctrl-p/t/n/h/o/s/b/g/q) are dropped so they reach nvim, fzf and zsh.
keybinds clear-defaults=true {
    normal {
        bind "Ctrl a" { SwitchToMode "Tmux"; }

        // vim-tmux-navigator replacement: move between nvim splits
        // (smart-splits.nvim) and zellij panes with the same keys.
        bind "Ctrl h" { MessagePlugin "navigator" { name "move_focus"; payload "left"; }; }
        bind "Ctrl j" { MessagePlugin "navigator" { name "move_focus"; payload "down"; }; }
        bind "Ctrl k" { MessagePlugin "navigator" { name "move_focus"; payload "up"; }; }
        bind "Ctrl l" { MessagePlugin "navigator" { name "move_focus"; payload "right"; }; }
    }

    tmux {
        bind "Esc" "Ctrl c" { SwitchToMode "Normal"; }
        // Ctrl-a Ctrl-a sends a literal Ctrl-a (tmux send-prefix).
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }
        // Ctrl-a Ctrl-l sends a literal Ctrl-l (Ctrl-l alone moves focus right).
        bind "Ctrl l" { Write 12; SwitchToMode "Normal"; }

        // Panes. New panes open in the focused pane's directory.
        bind "|" "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }
        bind ";" { FocusLastPane; SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Space" { NextSwapLayout; SwitchToMode "Normal"; }
        // tmux break-pane. `@` is only an approximation of join-pane: zellij
        // has no marked pane, so it moves the pane into the tab on the left.
        bind "!" { BreakPane; SwitchToMode "Normal"; }
        bind "@" { BreakPaneLeft; SwitchToMode "Normal"; }
        bind "Ctrl k" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        // Resize stays in tmux mode so the keys can be repeated.
        bind "Alt h" { Resize "Increase Left"; }
        bind "Alt j" { Resize "Increase Down"; }
        bind "Alt k" { Resize "Increase Up"; }
        bind "Alt l" { Resize "Increase Right"; }
        // Floating panes replace the tmux scratch popup (per tab, not global).
        bind "F" { ToggleFloatingPanes; SwitchToMode "Normal"; }

        // Tabs (tmux windows).
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; SwitchToMode "Normal"; }
        // The status bar labels tabs with their focused pane's title, so
        // `,` names the focused pane rather than the tab.
        bind "," { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "&" { CloseTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        // Sessions. The built-in session manager replaces the fzf pane popup
        // (g) and the go-to/create session popup (Ctrl-n): type to fuzzy
        // search sessions, tabs and panes; Ctrl-w creates a session; Tab
        // shows exited sessions to resurrect.
        bind "g" "s" "w" "Ctrl n" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        bind "$" {
            Run "zsh" "-fc" "read -r 'name?Rename session: ' && [[ -n $name ]] && zellij action rename-session \"$name\"" {
                floating true
                close_on_exit true
                name "rename session"
            }
            SwitchToMode "Normal"
        }
        bind "d" { Detach; }

        // Scrollback (tmux copy mode).
        bind "[" { SwitchToMode "Scroll"; }
        // Search the scrollback straight away (Ctrl-a [ then / in one step).
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        // Open the scrollback in $EDITOR (nvim) for vi-style search and yank.
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        // extrakto / tmux-fzf-url / tmux-fastcopy replacement: fuzzy-pick
        // URLs, paths, hashes, IPs and commands from the scrollback. In the
        // list, y copies, i inserts at the prompt, o opens, e edits.
        bind "f" {
            LaunchOrFocusPlugin "zextract" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
    }

    // Keep the leader available while scrolling, as in tmux copy mode.
    shared_among "scroll" "search" {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        bind "q" "Esc" "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "/" "?" "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "Ctrl d" "d" { HalfPageScrollDown; }
        bind "Ctrl u" "u" { HalfPageScrollUp; }
        bind "g" "Home" { ScrollToTop; }
        bind "G" "End" { ScrollToBottom; }
        // Shell prompt jumps and command output copy need the OSC 133 marks
        // from kitty's shell integration (see ~/.zshrc).
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "m" { SelectCommandAtScrollPosition; }
    }
    scroll {
        bind "c" { CopyLastCommandOutput; SwitchToMode "Normal"; }
    }
    search {
        bind "n" { Search "down"; }
        bind "N" "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    entersearch {
        bind "Esc" "Ctrl c" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    renamepane {
        bind "Enter" "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
    }
}

// Plugin aliases. Third-party plugins are pinned to a release URL; bump the
// version here (zellij caches the download and asks for permissions again).
plugins {
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm"
    navigator location="https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm"
    // Built for zellij 0.44; tested working on 0.45.1. Ctrl-w in its first
    // banner writes ~/.config/zellij/zextract.kdl with the defaults.
    zextract location="https://github.com/codingfragments/zellij-zextract/releases/download/v0.4.0/zextract.wasm"

    // Built-in aliases.
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

load_plugins {
    "zellij:link"
}

web_client {
    font "monospace"
}

theme "catppuccin-mocha"
default_shell "zsh"
// layouts/sahir.kdl: zjstatus bar at the top (tmux status-position top),
// zellij's key hints at the bottom.
default_layout "sahir"

// tmux history-limit.
scroll_buffer_size 100000

// tmux-resurrect/continuum replacement. Sessions are saved every 60s and
// survive the kitty window closing (on_force_close defaults to detach).
// Resurrected commands wait for Enter before they run.
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 10000

// Copying (mouse selection, CopyLastCommandOutput) goes to kitty through
// OSC 52, which also works over SSH; this replaces tmux-yank.
copy_on_select true
copy_clipboard "system"
// Double-click selects a word; quotes, commas and semicolons also end one,
// so a quoted path or URL selects without its quotes. `:` and `/` are not
// separators, so URLs and paths stay whole.
word_separators "[]{}<>()\"'`,;"

show_startup_tips false
// The release-notes screen offers to add missing default keybindings.
show_release_notes false
