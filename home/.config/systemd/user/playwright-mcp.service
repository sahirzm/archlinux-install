[Unit]
Description=Playwright MCP server (browser automation for agents)
After=graphical-session.target network.target

[Service]
Type=simple
# Headed browser needs the desktop session; adjust if your display differs.
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=%t
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
# Add --headless (and/or --browser=chrome) to ExecStart to change mode.
ExecStart=%h/.local/share/mise/shims/npx -y @playwright/mcp@latest --port 8931 --host 0.0.0.0 --allowed-hosts host.docker.internal host.docker.internal:8931
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
